{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyrasisorghome/InteroperabilityProject/registry/schema.json",
  "title": "IntegrationScenarioRecord",
  "description": "A registry record describing a real-world integration between LYRASIS CSTs or external systems. See specs/F1-dev-integration-registry-platform.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source_system",
    "target_system",
    "integration_type",
    "protocol",
    "status",
    "description",
    "submitted_by",
    "submitted_date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable UUID; must match the scenario filename (registry/scenarios/{id}.yaml)."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "source_system": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/system" }
    },
    "target_system": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/system" }
    },
    "integration_type": {
      "$ref": "#/$defs/integration_type"
    },
    "protocol": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/protocol" }
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "submitted_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500
    },
    "submitted_date": {
      "$ref": "#/$defs/dateTime"
    },
    "prerequisites": { "type": "string" },
    "configuration_notes": { "type": "string" },
    "code_repository_url": { "type": "string", "format": "uri" },
    "documentation_url": { "type": "string", "format": "uri" },
    "related_spec_url": { "type": "string", "format": "uri" },
    "related_scenario_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "min_system_version": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "def_system_version": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "last_verified_date": { "$ref": "#/$defs/date" },
    "contact_email": { "type": "string", "format": "email" },
    "license": {
      "type": "string",
      "description": "SPDX license identifier, e.g. CC-BY-4.0"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "updated_date": { "$ref": "#/$defs/dateTime" },
    "record_url": { "type": "string", "format": "uri" },
    "flagged": { "type": "boolean", "default": false }
  },
  "$defs": {
    "system": {
      "type": "string",
      "enum": [
        "ArchivesSpace",
        "DSpace",
        "CollectionSpace",
        "VIVO",
        "Fedora",
        "Other"
      ]
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "Linking",
        "Deposit",
        "Metadata Harvesting (OAI-PMH)",
        "Search/Discovery",
        "Bidirectional Sync",
        "Other"
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "SWORD v2",
        "SWORD v3",
        "OAI-PMH v2",
        "REST API",
        "SPARQL",
        "Custom/Bespoke",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Experimental",
        "Deprecated",
        "Retired",
        "Recalled"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
